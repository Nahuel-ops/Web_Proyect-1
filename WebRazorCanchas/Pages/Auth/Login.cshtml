@page
@model WebRazorCanchas.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white text-center py-4">
                    <h3 class="mb-0 fw-bold">Acceso al Sistema</h3>
                    <small class="opacity-75">Ingresa tus credenciales para gestionar las canchas</small>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.MensajeExito))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @Model.MensajeExito
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.MensajeError))
                    {
                        <div class="alert alert-danger" role="alert">
                            @Model.MensajeError
                        </div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Credenciales.NombreUsuario" class="form-label fw-semibold">Usuario</label>
                            <input asp-for="Credenciales.NombreUsuario" class="form-control form-control-lg" placeholder="Ingresa tu usuario" required />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Credenciales.Password" class="form-label fw-semibold">Contraseña</label>
                            <input asp-for="Credenciales.Password" type="password" class="form-control form-control-lg" placeholder="••••••••" required />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg fw-bold">
                                Iniciar Sesión
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <span class="text-muted">¿Aún no tienes cuenta?</span>
                    <a asp-page="/Auth/Registro" class="text-danger fw-bold text-decoration-none ms-1">Regístrate aquí</a>
                </div>
            </div>
        </div>
    </div>
</div>
